# ieum 환경 변수 예제
#
# 이 파일을 .env.local로 복사한 뒤 값을 채운다. 실제 값은 커밋하지 않는다.
# 값은 Supabase 대시보드 > Settings > API Keys 에서 확인한다.
#
# anon / service_role 로 불리는 eyJ... 형태의 legacy 키는 쓰지 않는다.
# 2026년 말 지원 종료 예정이며, 아래 sb_ 형식이 현재 키다.

# 브라우저에 노출되어도 되는 값. 접근 범위는 RLS가 정한다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 서버 전용. RLS를 우회하므로 NEXT_PUBLIC_ 접두사를 붙이면 안 된다.
# 현재 코드에서 사용하는 곳은 없다. 관리 작업이 필요해질 때 쓴다.
SUPABASE_SECRET_KEY=sb_secret_...

# 로그인을 허용할 소유자 이메일. 쉼표로 구분한다.
# 비밀값은 아니지만 Supabase 가입 차단에 이은 2차 방어선이다.
# 비워두면 아무도 로그인하지 못한다.
OWNER_EMAILS=you@example.com

# OpenAI API 키. 서버 전용이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# platform.openai.com > API keys 에서 발급한다.
OPENAI_API_KEY=sk-...
